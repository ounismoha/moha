<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme: diagonal dark gradient behind the custom 3-pane UI. -->
    <style name="Theme.NonoApp" parent="Theme.Leanback">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <!-- Setup / Xtream wizard uses the Leanback GuidedStep look. -->
    <style name="Theme.NonoApp.Setup" parent="Theme.Leanback.GuidedStep" />

    <!-- Nav rail item: icon + label, focusable with a white pill highlight. -->
    <style name="NavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/rail_item_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawableTint">@color/nav_text</item>
        <item name="android:duplicateParentState">false</item>
    </style>

    <!-- Full-screen player control button: icon on top, label below, soft focus pill. -->
    <style name="PlayerCtrl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/row_item_bg</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
    </style>

    <style name="PlayerCtrlLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
