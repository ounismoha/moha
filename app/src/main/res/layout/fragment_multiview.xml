<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E1420"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/mv_cell0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:focusable="true"
            android:background="@drawable/cell_focus_bg">
            <androidx.media3.ui.PlayerView
                android:id="@+id/mv_pv0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit"
                app:surface_type="texture_view" />
            <TextView
                android:id="@+id/mv_label0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#99000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mv_cell1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:focusable="true"
            android:background="@drawable/cell_focus_bg">
            <androidx.media3.ui.PlayerView
                android:id="@+id/mv_pv1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit"
                app:surface_type="texture_view" />
            <TextView
                android:id="@+id/mv_label1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#99000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/mv_cell2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:focusable="true"
            android:background="@drawable/cell_focus_bg">
            <androidx.media3.ui.PlayerView
                android:id="@+id/mv_pv2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit"
                app:surface_type="texture_view" />
            <TextView
                android:id="@+id/mv_label2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#99000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/mv_cell3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:focusable="true"
            android:background="@drawable/cell_focus_bg">
            <androidx.media3.ui.PlayerView
                android:id="@+id/mv_pv3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit"
                app:surface_type="texture_view" />
            <TextView
                android:id="@+id/mv_label3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#99000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
