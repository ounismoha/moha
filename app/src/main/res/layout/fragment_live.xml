<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Column 2: categories (focus drives the channel list in column 3) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/live_categories"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:background="@color/pane_mid"
        android:paddingHorizontal="10dp"
        android:paddingVertical="16dp"
        android:clipToPadding="false" />

    <!-- Column 3: reserved space for the floating 16:9 preview (top-right) + program info,
         then the vertical channel list fills the remaining height. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Reserves the top band where the windowed player overlays this pane.
             Program title/time sit at the bottom-left of the band, beside the preview. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="10dp"
                android:paddingEnd="432dp">

                <TextView
                    android:id="@+id/tv_program_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_program_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/live_channels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/pane_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
