<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xtream Codes"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:hint="Nom de la playlist (facultatif)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:singleLine="true"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/et_server"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:hint="Adresse du serveur (http://host:port)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/et_user"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:hint="Nom d'utilisateur"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="10dp"
            android:singleLine="true"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/et_pass"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:hint="Mot de passe"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:singleLine="true"
            android:inputType="textVisiblePassword"
            android:importantForAutofill="no" />

        <CheckBox
            android:id="@+id/cb_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inclure les chaînes de télévision"
            android:textColor="@color/text_primary"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cb_vod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inclure la VOD (Films &amp; Séries)"
            android:textColor="@color/text_primary"
            android:checked="true"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Se connecter" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/accent_pink"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
